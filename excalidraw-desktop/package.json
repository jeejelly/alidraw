{
  "name": "excalidraw-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Excalidraw (branch jeejelly) as a desktop app: local files only, no network",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux dir"
  },
  "build": {
    "appId": "local.excalidraw.desktop",
    "productName": "Excalidraw",
    "executableName": "excalidraw",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../excalidraw-app/build",
        "to": "app",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "linux": {
      "target": "dir",
      "category": "Graphics"
    }
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  }
}
